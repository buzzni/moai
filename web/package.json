{
  "name": "moai-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./tests/i18n-loader.mjs --test tests/*.test.mjs",
    "test:gantt-browser": "node --test tests/gantt.browser.mjs",
    "test:events-browser": "node --test tests/events.browser.mjs",
    "test:admission-browser": "node --test tests/admission.browser.mjs",
    "test:hatch-browser": "node --test tests/hatch.browser.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.1",
    "playwright": "1.64.1",
    "type-fest": "4.41.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mdit/plugin-cjk-friendly": "1.0.0",
    "@mdit/plugin-footnote": "1.2.0",
    "@mdit/plugin-katex": "1.2.0",
    "@mdit/plugin-snippet": "2.0.1",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
