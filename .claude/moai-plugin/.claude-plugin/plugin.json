{
  "description": "This repository's issue tracker. Loads the board into the session and keeps new issues from leaking outside the unit you picked up.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v -- \"/home/coder/workspace/moa-issue/target/release/moai\" >/dev/null 2>&1 && \"/home/coder/workspace/moa-issue/target/release/moai\" hook pre-tool-use || exit 0",
            "statusMessage": "checking the moai rules...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|NotebookEdit|Skill"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v -- \"/home/coder/workspace/moa-issue/target/release/moai\" >/dev/null 2>&1 && \"/home/coder/workspace/moa-issue/target/release/moai\" hook session-start || exit 0",
            "statusMessage": "counting moai warnings...",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "command -v -- \"/home/coder/workspace/moa-issue/target/release/moai\" >/dev/null 2>&1 && \"/home/coder/workspace/moa-issue/target/release/moai\" hook stop || exit 0",
            "statusMessage": "comparing the moai state...",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "command -v -- \"/home/coder/workspace/moa-issue/target/release/moai\" >/dev/null 2>&1 && \"/home/coder/workspace/moa-issue/target/release/moai\" hook user-prompt-submit || exit 0",
            "statusMessage": "reading the moai board...",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  },
  "name": "moai",
  "version": "112.25.346"
}
